   "source": [
    "per_page = 10\n",
    "\n",
    "try:\n",
    "\n",
    "    total_existing = spark.table(\"workspace.pipeline_breweries.bronze_breweries\").count()\n",
    "\n",
    "except:\n",
    "\n",
    "    total_existing = 0\n",
    "\n",
    "current_page = (total_existing // per_page) + 1\n",
    "\n",
    "dbutils.jobs.taskValue.set(key = \"current_page\", value = current_page)"
   ]
  }
